# Copy this file to .env and fill in your keys.

# Claude API key (the brain) — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Fish Audio API key (the voice) — get one at https://fish.audio
FISH_API_KEY=
# Use s2.1-pro-free on the free developer tier, or s2.1-pro on a paid plan
FISH_TTS_MODEL=s2.1-pro-free

PORT=3000
